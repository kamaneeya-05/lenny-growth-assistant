# ------------------------------------------------------------------------------
# THE LENNY GROWTH ASSISTANT - ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------

# App Settings
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Settings
# Default is native SQLite (zero-dependency, no Docker required):
DATABASE_URL=sqlite:///./data/lenny_assistant.db
# PostgreSQL alternative (if using external or Docker Postgres):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lenny_assistant

# Model Provider Selection: "ollama" | "anthropic" | "openai" | "mock"
DEFAULT_MODEL_PROVIDER=ollama
DEFAULT_MODEL_NAME=llama3.2

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=45

# Cloud LLM Configuration (Optional - leave blank if using Ollama or Mock)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval & Ingestion Settings
TRANSCRIPTS_DATA_DIR=./data/transcripts
VECTOR_STORE_DIR=./data/vector_store
CHUNK_SIZE_WORDS=380
CHUNK_OVERLAP_WORDS=50
RETRIEVAL_TOP_K=4
RETRIEVAL_CONFIDENCE_THRESHOLD=0.18
